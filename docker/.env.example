# Production Environment Variables
# Copy this file to .env and update the values

# Database
DB_ROOT_PASSWORD=your_secure_database_password_here

# Admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Site name (your domain)
SITE_NAME=crm.yourdomain.com

# Ports (Apache bu portlara proxy yapacak)
FRAPPE_PORT=8076
SOCKETIO_PORT=9076
